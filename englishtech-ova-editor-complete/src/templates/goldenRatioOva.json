            {
              "id": "blk-act-quiz",
              "type": "quiz_multiple",
              "title": "Autoevaluación Rápida de la Actividad",
              "metadata": {
                "questions": [
                  {
                    "id": "q-act-1",
                    "title": "Pregunta de Razonamiento",
                    "question": "¿Cuál es la expresión exacta del número de oro Phi (Φ)?",
                    "options": [
                      {
                        "id": "o1",
                        "text": "Φ = (1 + √5) / 2",
                        "isCorrect": true
                      },
                      {
                        "id": "o2",
                        "text": "Φ = (1 - √5) / 2",
                        "isCorrect": false
                      },
                      {
                        "id": "o3",
                        "text": "Φ = √2 / 2",
                        "isCorrect": false
                      },
                      {
                        "id": "o4",
                        "text": "Φ = 3.14159...",
                        "isCorrect": false
                      }
                    ],
                    "feedbackGood": "¡Excelente! La solución a la ecuación cuadrática x² - x - 1 = 0 es exactamente (1 + √5) / 2 ≈ 1.618.",
                    "feedbackBad": "Revisa la fórmula de la razón media y extrema de Euclides: (1 + √5) / 2."
                  }
                ]
              }
            }
          ]
        }
      ]
