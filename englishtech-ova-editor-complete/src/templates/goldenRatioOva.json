    {
      "id": "page-quiz",
      "title": "Prueba",
      "type": "activity",
      "icon": "CheckCircle2",
      "subSlides": [
        {
          "id": "slide-quiz-1",
          "title": "1. Relaciones de Conjuntos Numéricos",
          "blocks": [
            {
              "id": "blk-quiz-sets",
              "type": "quiz_multiple",
              "title": "Verdadero o Falso: Conjuntos R, Q, I",
              "content": "Considera los conjuntos R (Reales), Q (Racionales) e I (Irracionales). Determina el valor de verdad:",
              "metadata": {
                "questions": [
                  {
                    "id": "qs1",
                    "title": "Proposición A",
                    "question": "I ∩ Q = ∅ (La intersección entre irracionales y racionales es vacía)",
                    "options": [
                      {
                        "id": "qa1",
                        "text": "Verdadera",
                        "isCorrect": true
                      },
                      {
                        "id": "qa2",
                        "text": "Falsa",
                        "isCorrect": false
                      }
                    ],
                    "feedbackGood": "¡Correcto! Racionales e irracionales son disjuntos.",
                    "feedbackBad": "Incorrecto. Ningún número puede ser ambos a la vez."
                  },
                  {
                    "id": "qs2",
                    "title": "Proposición B",
                    "question": "I ∪ Q = R (La unión de irracionales y racionales da los Reales)",
                    "options": [
                      {
                        "id": "qb1",
                        "text": "Verdadera",
                        "isCorrect": true
                      },
                      {
                        "id": "qb2",
                        "text": "Falsa",
                        "isCorrect": false
                      }
                    ],
                    "feedbackGood": "¡Correcto! Todo número real es racional o irracional.",
                    "feedbackBad": "Incorrecto. R se compone exactamente de Q e I."
                  },
                  {
                    "id": "qs3",
                    "title": "Proposición C",
                    "question": "I ⊂ R (Los irracionales son un subconjunto de los reales)",
                    "options": [
                      {
                        "id": "qc1",
                        "text": "Verdadera",
                        "isCorrect": true
                      },
                      {
                        "id": "qc2",
                        "text": "Falsa",
                        "isCorrect": false
                      }
                    ],
                    "feedbackGood": "¡Correcto! Todos los irracionales pertenecen a la recta real.",
                    "feedbackBad": "Incorrecto. Los irracionales forman parte de los reales."
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "slide-quiz-2",
          "title": "2. Problema del Área Cuadrada",
          "blocks": [
            {
              "id": "blk-quiz-geom",
              "type": "quiz_multiple",
              "title": "Longitud y Razón Irracional",
              "content": "Analiza la siguiente situación geométrica:",
              "metadata": {
                "questions": [
                  {
                    "id": "qg1",
                    "title": "Área de cuadrado = 5 cm²",
                    "question": "Si el área A de un cuadrado es A = l^2 = 5 cm^2, ¿qué podemos afirmar de la longitud de su lado l?",
                    "options": [
                      {
                        "id": "og1",
                        "text": "La longitud del lado es un número irracional (l = √5 cm).",
                        "isCorrect": true
                      },
                      {
                        "id": "og2",
                        "text": "La longitud del lado es un número racional.",
                        "isCorrect": false
                      },
                      {
                        "id": "og3",
                        "text": "No se puede determinar.",
                        "isCorrect": false
                      }
                    ],
                    "feedbackGood": "¡Muy bien! l = √5 es un número irracional.",
                    "feedbackBad": "Incorrecto. 5 no es cuadrado perfecto, por lo que √5 es irracional."
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "page-conclusion",
